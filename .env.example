# ---------------------------------------------------------------------------
# Copy to .env.local (git-ignored) and fill in. The same file works for the
# Next.js app and the @charm/db scripts.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (Atlas > Cluster > Connect > Drivers).
# Remember to URL-encode any special characters in the password.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Database name inside the cluster. Keeps portfolio data in its own namespace.
MONGODB_DB="charm_portfolio"

# Secret used to sign the admin session JWT.
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical public origin. Drives canonical URLs, sitemap, robots and OG tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="https://www.charmthiekshana.com"

# Optional: shared secret for POST /api/revalidate, so you can purge the cache
# from outside the admin panel. Generate the same way as AUTH_SECRET.
REVALIDATE_SECRET=""

# Optional: email notifications for new contact-form messages.
# Leave RESEND_API_KEY empty to store messages in the admin inbox only.
RESEND_API_KEY=""
CONTACT_NOTIFY_EMAIL="charmthiekshana97@gmail.com"

# Optional: Google Search Console data on /admin/analytics. All three must be
# set together, or the section shows setup instructions instead. See "Search
# Console data" in the README for how to create the service account.
GSC_CLIENT_EMAIL=""
GSC_PRIVATE_KEY=""
GSC_SITE_URL=""
