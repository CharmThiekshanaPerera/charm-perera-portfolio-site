{
  "name": "charm-perera-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo for charmperera.com — Next.js portfolio site with an integrated admin CMS backed by MongoDB.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "seed": "npm run seed --workspace=@charm/db",
    "create-admin": "npm run create-admin --workspace=@charm/db",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.2.0"
}
